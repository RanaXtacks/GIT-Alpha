{
  "name": "git-alpha",
  "displayName": "GIT-Alpha",
  "description": "Real-time Project Health & Security Dashboard for VS Code",
  "publisher": "RanaXtacks",
  "version": "0.0.5",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RanaXtacks/GIT-Alpha"
  },
  "homepage": "https://github.com/RanaXtacks/GIT-Alpha#readme",
  "bugs": {
    "url": "https://github.com/RanaXtacks/GIT-Alpha/issues"
  },
  "keywords": [
    "security",
    "code quality",
    "dashboard",
    "AI",
    "gemini"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:git-alpha.openDashboard",
    "onCommand:git-alpha.login",
    "onCommand:git-alpha.setGeminiKey"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "git-alpha.openDashboard",
        "title": "GIT-Alpha: Open Dashboard"
      },
      {
        "command": "git-alpha.login",
        "title": "GIT-Alpha: Login to GitHub"
      },
      {
        "command": "git-alpha.setGeminiKey",
        "title": "GIT-Alpha: Set Gemini API Key"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild ./extension/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run compile -- --watch",
    "package": "npx @vscode/vsce package",
    "lint": "eslint . --ext .ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "fast-glob": "^3.3.1",
    "ignore": "^5.2.4",
    "zod": "^3.22.2"
  }
}